# Copie para .env e ajuste. Strings vazias valem como "não definido".

# Postgres local: `docker compose up -d` na raiz do repositório
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meu_caixa
DATABASE_MIGRATE_ON_START=true

PORT=3000
TIMEZONE=America/Sao_Paulo

# URL pública por onde o browser chega na API. A interface faz proxy de /auth e
# /api, então em dev é a própria interface (callback: ${APP_URL}/auth/callback)
APP_URL=http://localhost:3001
# Interface: destino depois do login/logout e origem liberada no CORS
FRONTEND_URL=http://localhost:3001
# Assina o cookie de sessão. Obrigatório em produção. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Keycloak local (`docker compose up -d`): realm meu-caixa, usuário dev/dev
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=meu-caixa
KEYCLOAK_CLIENT_ID=web
KEYCLOAK_CLIENT_SECRET=meu-caixa-dev-secret
# Role (do realm ou do client) exigida para ver os dados
KEYCLOAK_REQUIRED_ROLE=owner

# pluggy = dados reais | fake = dados fictícios, sem credenciais
FINANCE_PROVIDER=fake
PROVIDER_CACHE_TTL_SECONDS=300

# Credenciais da aplicação no dashboard da Pluggy (dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Ids dos items (bancos conectados via Meu Pluggy), separados por vírgula
PLUGGY_ITEM_IDS=
PLUGGY_TIMEOUT_MS=15000
PLUGGY_MAX_RETRIES=3

SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=6
# Histórico buscado na primeira sincronização de cada conta
SYNC_LOOKBACK_DAYS=365
# Dias revisitados a cada sincronização, para pegar pendentes que viraram efetivadas
SYNC_OVERLAP_DAYS=7
