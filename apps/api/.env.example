# Copie para .env e ajuste. Strings vazias valem como "não definido".

# Postgres local: `docker compose up -d` na raiz do repositório
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meu_caixa
DATABASE_MIGRATE_ON_START=true

PORT=3000
TIMEZONE=America/Sao_Paulo

# URL pública por onde o browser chega na API. A interface faz proxy de /auth e
# /api, então em dev é a própria interface (callback: ${APP_URL}/auth/callback)
APP_URL=http://localhost:3001
# Interface: destino depois do login/logout e origem liberada no CORS
FRONTEND_URL=http://localhost:3001
# Assina o cookie de sessão. Obrigatório em produção. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Keycloak local (`docker compose up -d`): realm meu-caixa, usuário dev/dev
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=meu-caixa
KEYCLOAK_CLIENT_ID=web
KEYCLOAK_CLIENT_SECRET=meu-caixa-dev-secret
# Role (do realm ou do client) exigida para ver os dados
KEYCLOAK_REQUIRED_ROLE=owner

# Servidor MCP (/mcp) para o Claude. Tokens OAuth do Keycloak valem quando a
# audiência inclui ${APP_URL}/mcp (mapper do client "claude" no realm).
# Opcional: clients do Keycloak (azp) aceitos mesmo sem essa audiência, ex.: claude
MCP_ALLOWED_CLIENTS=
# Opcional: segredo para o Claude Code/Desktop sem OAuth (header
# "Authorization: Bearer <valor>"). Gere com: openssl rand -hex 32
MCP_ACCESS_TOKEN=

# Análise pelo app ("Gerar análise" e "Pergunte ao Claude"): a chave e o
# modelo da Anthropic são cadastrados na tela Configurações (cifrados com a
# SETTINGS_ENCRYPTION_KEY abaixo). Paga por uso na sua conta da Anthropic.
# Opcional: outro endpoint da API de Messages (ex.: um mock local para testes)
ANTHROPIC_BASE_URL=

# pluggy = dados reais | fake = dados fictícios, sem credenciais
FINANCE_PROVIDER=fake
PROVIDER_CACHE_TTL_SECONDS=300

# Credenciais da Pluggy e chave da Anthropic são cadastradas na tela
# Configurações e ficam no banco, com os segredos cifrados por esta chave.
# Obrigatória com FINANCE_PROVIDER=pluggy (e para salvar a chave da Anthropic).
# Gere com: openssl rand -hex 32 — trocar depois obriga a recadastrar os segredos.
SETTINGS_ENCRYPTION_KEY=
PLUGGY_TIMEOUT_MS=15000
PLUGGY_MAX_RETRIES=3

SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=6
# Histórico buscado na primeira sincronização de cada conta
SYNC_LOOKBACK_DAYS=365
# Dias revisitados a cada sincronização, para pegar pendentes que viraram efetivadas
SYNC_OVERLAP_DAYS=7
