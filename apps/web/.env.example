# Copie para .env.local.

# api = dados reais da API (precisa da API, do Postgres e do Keycloak rodando)
# mock = dados fictícios, sem nenhum back-end — bom para mexer só na interface
DATA_SOURCE=api

# Onde a API responde, visto do servidor do Next (também é o destino do proxy de /api e /auth)
API_URL=http://localhost:3000
TIMEZONE=America/Sao_Paulo
