# Droplet do BANCO (docker-compose.db.yml). Neste Droplet, copie para
# deploy/.env e preencha. O .env NUNCA vai para o git (está no .gitignore).
# Passo a passo: docs/deploy.md, "Banco num Droplet separado".
COMPOSE_FILE=docker-compose.db.yml

# IP privado (VPC) deste Droplet: o Postgres só escuta nele. Veja com
#   ip -4 addr show eth1   (ou no painel: Droplet → Networking → Private IP)
DB_BIND_IP=10.116.0.3

# Senhas: só letras e números. Gere com  openssl rand -hex 32
# Superusuário "postgres" (backups e manutenção).
POSTGRES_PASSWORD=troque-por-openssl-rand-hex-32
# Usuário "meu_caixa": a MESMA senha vai no .env do Droplet do app.
APP_DB_PASSWORD=troque-por-openssl-rand-hex-32
# Atenção: as senhas só são aplicadas na PRIMEIRA subida (volume vazio).

# --- Backups (deploy/backup.sh) -----------------------------------------------
BACKUP_DIR=/var/backups/meu-caixa
BACKUP_RETENTION_DAYS=14
# Opcional: cópia para o DigitalOcean Spaces (precisa do aws-cli ou s3cmd).
SPACES_BUCKET=
SPACES_REGION=nyc3
SPACES_PREFIX=meu-caixa
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
