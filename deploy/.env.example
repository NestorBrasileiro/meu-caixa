# Produção do Meu Caixa (deploy/docker-compose.yml). Copie para deploy/.env e
# preencha. O .env NUNCA vai para o git (está no .gitignore).
#
# Senhas e segredos: use só letras e números (vão dentro de URLs). Gere todos de
# uma vez com o comando da seção "Preencher o .env" do docs/deploy.md, ou um a
# um com:  openssl rand -hex 32

# --- Domínios -----------------------------------------------------------------
# Endereço da interface (registro DNS tipo A apontando para o IP do Droplet).
DOMAIN=meucaixa.exemplo.com.br
# Endereço do login (Keycloak). Outro registro A para o mesmo IP.
AUTH_DOMAIN=auth.meucaixa.exemplo.com.br
# E-mail para o Let's Encrypt avisar sobre os certificados HTTPS.
ACME_EMAIL=voce@exemplo.com.br

# --- Postgres -----------------------------------------------------------------
# Superusuário "postgres" (backups e manutenção).
POSTGRES_PASSWORD=troque-por-openssl-rand-hex-32
# Usuário "meu_caixa" do banco da aplicação.
APP_DB_PASSWORD=troque-por-openssl-rand-hex-32
# Usuário "keycloak" do banco do Keycloak.
KEYCLOAK_DB_PASSWORD=troque-por-openssl-rand-hex-32
# Atenção: as três senhas acima só são aplicadas na PRIMEIRA subida (volume
# vazio). Para trocar depois, veja "Trocar senhas" no docs/deploy.md.

# --- Keycloak (login) ---------------------------------------------------------
# Admin temporário do console, criado na primeira subida. Depois de criar o seu
# admin definitivo, apague este (docs/deploy.md).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-por-openssl-rand-hex-32
# Segredo do client "web" (a API). Entra no realm na primeira importação.
KEYCLOAK_CLIENT_SECRET=troque-por-openssl-rand-hex-32
# Endereço do console de administração. Padrão: túnel SSH para a porta 8180.
# Para abrir o console na internet: KEYCLOAK_ADMIN_URL=https://<AUTH_DOMAIN> e
# KEYCLOAK_ADMIN_PUBLIC=true (não recomendado).
KEYCLOAK_ADMIN_URL=http://localhost:8180
KEYCLOAK_ADMIN_PUBLIC=false

# --- API ----------------------------------------------------------------------
# Assina o cookie de sessão (mín. 32 caracteres).
SESSION_SECRET=troque-por-openssl-rand-hex-32
# Fuso do "hoje" e das datas.
TIMEZONE=America/Sao_Paulo

# pluggy = seus bancos de verdade | fake = dados fictícios (só para testar)
FINANCE_PROVIDER=pluggy
# Cifra os segredos salvos no banco pela tela Configurações (Client Secret da
# Pluggy e chave da Anthropic). Obrigatória com FINANCE_PROVIDER=pluggy.
# Gere com: openssl rand -hex 32 — e guarde: trocar obriga a recadastrar.
SETTINGS_ENCRYPTION_KEY=
# Sincronização automática com os bancos
SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=6

# --- Claude (opcionais) -------------------------------------------------------
# Vazias = recurso desligado; a API sobe normalmente sem elas.
# A chave da Anthropic ("Gerar análise" / "Pergunte ao Claude") é cadastrada
# na tela Configurações, cifrada com a SETTINGS_ENCRYPTION_KEY.
# Clientes MCP sem OAuth usam o token pessoal gerado em Configurações (o Claude
# usa OAuth com o client "claude" do Keycloak e não precisa dele).
# Clients do Keycloak aceitos no /mcp mesmo sem a audiência do MCP (separados
# por vírgula). Vazio = só tokens com aud https://DOMAIN/mcp.
MCP_ALLOWED_CLIENTS=

# --- Backups (deploy/backup.sh) -----------------------------------------------
# Pasta no Droplet onde ficam os .sql.gz e por quantos dias são mantidos.
BACKUP_DIR=/var/backups/meu-caixa
BACKUP_RETENTION_DAYS=14
# Opcional: cópia para o DigitalOcean Spaces (precisa do aws-cli ou s3cmd).
# Vazio = só backup local.
SPACES_BUCKET=
SPACES_REGION=nyc3
SPACES_PREFIX=meu-caixa
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
