{
  "realm": "meu-caixa",
  "displayName": "Meu Caixa",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "client": {
      "web": [
        {
          "name": "owner",
          "description": "Acesso aos dados financeiros do Meu Caixa"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "web",
      "name": "Meu Caixa",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "meu-caixa-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3001/auth/callback"],
      "webOrigins": ["http://localhost:3001"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001"
      }
    },
    {
      "clientId": "claude",
      "name": "Claude (MCP)",
      "description": "Conectores do Claude (claude.ai, Claude Desktop, Claude Code) acessando o /mcp",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "https://claude.ai/api/mcp/auth_callback",
        "https://claude.com/api/mcp/auth_callback",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audiencia-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "http://localhost:3001/mcp",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "web": [
      {
        "client": "claude",
        "roles": ["owner"]
      }
    ]
  },
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "email": "dev@meucaixa.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Local",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "clientRoles": {
        "web": ["owner"]
      }
    }
  ]
}
